# Copy to .env.local and adjust

# Admin panel password — overrides the built-in first-admin bootstrap (recommended on Vercel)
# VITE_ADMIN_PASSWORD=Qpal.1122

# First admin bootstrap email (default: admin@elara.local)
# VITE_ADMIN_EMAIL=

# Customer login redirect if you replace the default /login (optional)
# VITE_LOGIN_PATH=/login

# OTP password recovery TTL in minutes (default 15)
# VITE_OTP_TTL_MIN=15

# Optional: receive order notification emails (CheckoutModal).
# Can also be set in Admin → Integrations → Email (order_notification_email).
# VITE_ORDER_NOTIFICATION_EMAIL=

# Optional: POST JSON payload when an order is placed (legacy fallback)
# VITE_ORDER_NOTIFY_WEBHOOK=

# ───────────────────────────────────────────────────────────────────
# Transactional email — SECRET keys for the /api/send-email function.
# These are SERVER env vars (NO VITE_ prefix). Set them in Vercel.
# Choose ONE provider and match it in Admin → Integrations → Email.
# ───────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER=resend            # resend | sendgrid | mailgun
# EMAIL_FROM=Cloud Elara <no-reply@yourdomain.com>
#
# Resend (resend.com → API Keys):
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
#
# SendGrid (app.sendgrid.com → Settings → API Keys):
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx
#
# Mailgun (app.mailgun.com → Sending → Domain settings):
# MAILGUN_API_KEY=xxxxxxxxxxxxxxxx
# MAILGUN_DOMAIN=mg.yourdomain.com
# MAILGUN_API_BASE=https://api.mailgun.net   # use https://api.eu.mailgun.net for EU

# ───────────────────────────────────────────────────────────────────
# Authentication providers — PUBLIC/client-safe keys are entered in the
# admin UI (Admin → Integrations → Authentication) and stored per-store.
# No server env vars are required for the auth providers.
# ───────────────────────────────────────────────────────────────────

# Optional app id (legacy URL params still work: ?app_id=)
# VITE_APP_ID=elara-local

# Optional API base if you add a custom backend later
# VITE_API_BASE_URL=

# Legacy Base44 env names are still read if present:
# VITE_BASE44_APP_ID=
# VITE_BASE44_APP_BASE_URL=
